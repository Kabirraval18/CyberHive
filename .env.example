# ============================================================
# CyberHive Configuration
# ============================================================

# Flask
SECRET_KEY=replace-with-a-random-secret
FLASK_ENV=development
FLASK_DEBUG=true

# Database
DATABASE_URL=sqlite:///data/cyberhive.db

# Cowrie
COWRIE_LOG_PATH=
COWRIE_LOG_URL=

RUN_ANALYSIS_ON_INGEST=true
RUN_RECLUSTER_ON_INGEST=true

# Threat intelligence
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

ABUSEIPDB_ENABLED=true
VIRUSTOTAL_ENABLED=true

INTEL_CACHE_SECONDS=86400
ABUSEIPDB_MAX_AGE_DAYS=90
RUN_ABUSEIPDB_ON_INGEST=true

# Risk
RISK_ALERT_THRESHOLD=40

# Email
EMAIL_ALERTS_ENABLED=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

ALERT_EMAIL_RECIPIENTS=

# Authentication bootstrap (used once during initial database setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-run
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=3600
DASHBOARD_REFRESH_INTERVAL_MS=5000

# Frontend
FRONTEND_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=INFO